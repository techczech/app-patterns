{
  "name": "@app-patterns/settings-react",
  "version": "0.3.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "The shared Settings window for desktop apps: React components driven only by props, plus settings.css. No IPC, no Electron, no file access.",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build:css": "mkdir -p dist && cp src/settings.css dist/settings.css",
    "build": "bun run gen:css && bun run build:deps && bun run build:js && bun run build:css",
    "demo": "bun run gen:css && bun run demo/serve.ts",
    "demo:build": "bun run demo/build.ts",
    "test": "bun test",
    "check": "bun run gen:css && bun run typecheck && bun test && bun run build",
    "gen:css": "bun run scripts/gen-css.ts",
    "build:deps": "bun run --cwd ../commands build && bun run --cwd ../settings build",
    "build:js": "tsc -p tsconfig.build.json"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./settings.css": "./dist/settings.css"
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "@app-patterns/commands": "^0.3.0",
    "@app-patterns/settings": "^0.3.0",
    "lucide-react": ">=0.468.0 <2",
    "react": ">=18"
  },
  "devDependencies": {
    "@app-patterns/commands": "workspace:*",
    "@app-patterns/settings": "workspace:*",
    "@testing-library/react": "16.3.0",
    "@types/bun": "^1.3.14",
    "@types/jsdom": "21.1.7",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "jsdom": "26.1.0",
    "lucide-react": "1.21.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "6.0.3"
  }
}
