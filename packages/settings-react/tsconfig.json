{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "paths": {
      "@app-patterns/settings": [
        "../settings/src/index.ts"
      ],
      "@app-patterns/commands": [
        "../commands/src/index.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "demo/**/*.ts",
    "demo/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
